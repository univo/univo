{
	"$schema": "https://biomejs.dev/schemas/1.9.2/schema.json",
	"organizeImports": {
		"enabled": false
	},
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"correctness": {
				"noUnusedImports": "warn"
			},
			"a11y": {
				"noSvgWithoutTitle": "off"
			},
			"style": {
				"useImportType": "off",
				"noNonNullAssertion": "off",
				"useSelfClosingElements": "off",
				"useSingleVarDeclarator": "off"
			},
			"suspicious": {
				"useAwait": "off",
				"noExplicitAny": "off",
				"noCommentText": "off"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"lineWidth": 160,
		"indentStyle": "tab"
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	}
}