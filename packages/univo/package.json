{
	"name": "univo",
	"license": "MIT",
	"type": "module",
	"version": "0.1.15",
	"sideEffects": false,
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"bin": {
		"univo": "dist/cli.mjs"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs"
		},
		"./client": {
			"types": "./dist/client.d.ts",
			"import": "./dist/client.mjs"
		},
		"./realtime": {
			"types": "./dist/realtime.d.ts",
			"import": "./dist/realtime.mjs"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"test": "vitest",
		"build": "unbuild",
		"univo": "NODE_ENV=production LOG_LEVEL=DEBUG jiti ./src/cli",
		"build:release": "pnpm build && changelogen --release --push && pnpm build && npm publish"
	},
	"dependencies": {
		"citty": "^0.1.6",
		"dotenv": "^17.2.2",
		"open": "^10.2.0",
		"partysocket": "^1.1.3",
		"ws": "^8.18.1"
	},
	"devDependencies": {
		"@hono/node-server": "^1.14.1",
		"@types/node": "^20.11.27",
		"@types/ws": "^8.18.1",
		"changelogen": "^0.6.1",
		"hono": "^4.7.8",
		"jiti": "^2.4.2",
		"msw": "^2.10.2",
		"typescript": "^5.8.2",
		"unbuild": "^3.5.0",
		"viem": "2.45.1",
		"vitest": "^3.1.3"
	}
}