{
	"name": "univo",
	"license": "MIT",
	"type": "module",
	"version": "0.3.1",
	"sideEffects": false,
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"bin": {
		"univo": "dist/cli.mjs"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs"
		},
		"./rpc": {
			"types": "./dist/rpc.d.ts",
			"import": "./dist/rpc.mjs"
		},
		"./transport": {
			"types": "./dist/transport.d.ts",
			"import": "./dist/transport.mjs"
		},
		"./realtime": {
			"types": "./dist/realtime.d.ts",
			"import": "./dist/realtime.mjs"
		},
		"./metadata": {
			"types": "./dist/metadata.d.ts",
			"import": "./dist/metadata.mjs"
		},
		"./metadata/adapters": {
			"types": "./dist/metadata/adapters.d.ts",
			"import": "./dist/metadata/adapters.mjs"
		},
		"./metadata/adapters/s3": {
			"types": "./dist/metadata/adapters/s3.d.ts",
			"import": "./dist/metadata/adapters/s3.mjs"
		},
		"./metadata/adapters/r2": {
			"types": "./dist/metadata/adapters/r2.d.ts",
			"import": "./dist/metadata/adapters/r2.mjs"
		},
		"./metadata/adapters/r2-binding": {
			"types": "./dist/metadata/adapters/r2-binding.d.ts",
			"import": "./dist/metadata/adapters/r2-binding.mjs"
		},
		"./metadata/adapters/memory": {
			"types": "./dist/metadata/adapters/memory.d.ts",
			"import": "./dist/metadata/adapters/memory.mjs"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"test": "vitest",
		"build": "unbuild",
		"univo": "NODE_ENV=production LOG_LEVEL=DEBUG jiti ./src/cli"
	},
	"dependencies": {
		"aws4fetch": "1.0.20",
		"citty": "^0.1.6",
		"dotenv": "^17.2.2",
		"fast-xml-parser": "5.11.1",
		"open": "^10.2.0",
		"partysocket": "^1.1.3",
		"ws": "^8.18.1"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "5.20260914.1",
		"@types/node": "^20.11.27",
		"@types/ws": "^8.18.1",
		"changelogen": "^0.6.1",
		"jiti": "^2.4.2",
		"msw": "^2.10.2",
		"typescript": "^5.8.2",
		"unbuild": "^3.5.0",
		"viem": "2.45.1",
		"vitest": "^3.1.3"
	},
	"peerDependencies": {
		"@cloudflare/workers-types": "*",
		"viem": ">=2.45.1 <3"
	},
	"peerDependenciesMeta": {
		"@cloudflare/workers-types": {
			"optional": true
		}
	}
}